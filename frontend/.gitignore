# ── Build output ──────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out

# ── Angular tool cache ────────────────────────────────────
# Covers the full .angular directory (build cache, build info, etc.)
/.angular

# ── Node ──────────────────────────────────────────────────
/node_modules

# ── Environment & secrets ─────────────────────────────────
.env
.env.local
.env.*.local
*.local.ts
src/environments/*.local.*

# ── Test output ───────────────────────────────────────────
/coverage
testem.log

# ── Build profiling ───────────────────────────────────────
# Generated by: ng build --stats-json
/stats.json
chrome-profiler-events*.json

# ── Style caches ──────────────────────────────────────────
.sass-cache/

# ── IDE & editors ─────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Keep VS Code settings that help the team (shared config)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ── OS files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
yarn-debug.log*
lerna-debug.log*

# ── Misc ──────────────────────────────────────────────────
*.orig
connect.lock
libpeerconnection.log
