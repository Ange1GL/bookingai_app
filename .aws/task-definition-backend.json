                },
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/DB_PASSWORD"
                },
                {
                    "name": "DEEPSEEK_API_KEY",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/DEEPSEEK_API_KEY"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
