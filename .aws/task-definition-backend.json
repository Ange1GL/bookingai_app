{
    "family": "aglacita-tf-qa-api",
    "containerDefinitions": [
        {
            "name": "api",
            "image": "707256068332.dkr.ecr.us-east-1.amazonaws.com/aglacita-tf-qa-api:replaced-by-ci",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8082,
                    "protocol": "tcp"
                }
            ],
            "secrets": [
                {
                    "name": "DB_URL",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/DB_URL"
                },
                {
                    "name": "DB_USERNAME",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/DB_USERNAME"
                },
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/DB_PASSWORD"
                },
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/JWT_SECRET"
                },
                {
                    "name": "DEEPSEEK_API_KEY",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/DEEPSEEK_API_KEY"
                },
                {
                    "name": "API_OPENAI_KEY",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/API_OPENAI_KEY"
                },
                {
                    "name": "WHATSAPP_VERIFY_TOKEN",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/WHATSAPP_VERIFY_TOKEN"
                },
                {
                    "name": "WHATSAPP_APP_SECRET",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/WHATSAPP_APP_SECRET"
                },
                {
                    "name": "HOST_CORS",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/HOST_CORS"
                },
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "valueFrom": "arn:aws:ssm:us-east-1:707256068332:parameter/aglacita-tf/qa/SPRING_PROFILES_ACTIVE"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/aglacita-tf-qa-api",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "api"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -fs http://localhost:8082/actuator/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 240
            }
        }
    ],
    "executionRoleArn": "arn:aws:iam::707256068332:role/aglacita-tf-qa-api-execution",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}
