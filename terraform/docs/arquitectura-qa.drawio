<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram id="infraestructura-qa" name="Infraestructura QA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="user" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;Navegador (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="120" height="70" as="geometry"/></mxCell><mxCell id="aws" value="&lt;b&gt;AWS Cloud · recursos aglacita-tf-qa-* (Terraform, envs/qa)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="170" y="20" width="1360" height="900" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;CloudFront (distribución del front)&lt;/b&gt;&lt;br&gt;• HTTPS obligatorio (redirige HTTP)&lt;br&gt;• PriceClass_100&lt;br&gt;• Por defecto: S3 vía OAC + función spa-rewrite&lt;br&gt;• /api/*: API Gateway, sin caché, todos los métodos&lt;br&gt;• Headers de seguridad (política administrada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="aws"><mxGeometry x="30" y="310" width="250" height="190" as="geometry"/></mxCell><mxCell id="oac" value="&lt;b&gt;OAC (sigv4)&lt;/b&gt;&lt;br&gt;firma las peticiones a S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EB;strokeColor=#DD344C;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="aws"><mxGeometry x="30" y="520" width="115" height="60" as="geometry"/></mxCell><mxCell id="cff" value="&lt;b&gt;CF Function&lt;/b&gt;&lt;br&gt;spa-rewrite: rutas sin extensión → /index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="aws"><mxGeometry x="160" y="520" width="120" height="90" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Región us-east-1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="aws"><mxGeometry x="300" y="30" width="1040" height="850" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 aglacita-tf-qa-front-&amp;lt;cuenta&amp;gt;&lt;/b&gt;&lt;br&gt;• Privado (Block Public Access)&lt;br&gt;• Cifrado, versionado y ciclo de vida&lt;br&gt;• Política: solo CloudFront (OAC)&lt;br&gt;• Contenido lo sube el CI (Angular)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5DF;strokeColor=#3F8624;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="30" y="40" width="250" height="125" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b&gt;API Gateway (HTTP API) aglacita-tf-qa-api&lt;/b&gt;&lt;br&gt;• Ruta ANY /{proxy+}&lt;br&gt;• Stage $default (auto-deploy)&lt;br&gt;• Throttling 50 rps / ráfaga 100&lt;br&gt;• Integración HTTP_PROXY por VPC_LINK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="30" y="240" width="250" height="135" as="geometry"/></mxCell><mxCell id="apilog" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;/apigw/aglacita-tf-qa-api&lt;br&gt;accesos en JSON · 14 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE6F2;strokeColor=#E7157B;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="30" y="405" width="250" height="65" as="geometry"/></mxCell><mxCell id="vpc" value="&lt;b&gt;VPC por defecto (compartida con el QA manual) · subredes públicas, sin NAT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#248814;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="reg"><mxGeometry x="320" y="40" width="700" height="545" as="geometry"/></mxCell><mxCell id="azs" value="&lt;b&gt;Subredes por zona de disponibilidad&lt;/b&gt;&lt;br&gt;1a · 1b · 1c · 1d · 1e · 1f (la tarea puede correr en las seis; el VPC Link usa cinco)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="vpc"><mxGeometry x="20" y="40" width="660" height="50" as="geometry"/></mxCell><mxCell id="vpclink" value="&lt;b&gt;VPC Link aglacita-tf-qa-vpclink&lt;/b&gt;&lt;br&gt;• Subredes: 1a, 1b, 1c, 1d, 1f&lt;br&gt;• Excluye use1-az3 (1e): sin servicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="vpc"><mxGeometry x="20" y="200" width="210" height="100" as="geometry"/></mxCell><mxCell id="sgvl" value="&lt;b&gt;SG vpclink-sg&lt;/b&gt;&lt;br&gt;Sin entrada&lt;br&gt;Salida: TCP 8082 solo hacia api-sg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EB;strokeColor=#DD344C;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="vpc"><mxGeometry x="20" y="315" width="210" height="80" as="geometry"/></mxCell><mxCell id="cmap" value="&lt;b&gt;Cloud Map aglacita-tf.local&lt;/b&gt;&lt;br&gt;Servicio api (registro SRV, TTL 15 s)&lt;br&gt;ECS registra y borra la IP de la tarea sola" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="vpc"><mxGeometry x="20" y="415" width="210" height="110" as="geometry"/></mxCell><mxCell id="cluster" value="&lt;b&gt;ECS Cluster aglacita-tf-qa-cluster (Fargate)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="vpc"><mxGeometry x="270" y="110" width="410" height="420" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;ECS Service aglacita-tf-qa-api&lt;/b&gt;&lt;br&gt;• desired_count = variable (0 apaga, 1 enciende)&lt;br&gt;• Circuit breaker con rollback&lt;br&gt;• ignore_changes en task_definition (despliega el CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#ED7100;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="cluster"><mxGeometry x="20" y="40" width="370" height="100" as="geometry"/></mxCell><mxCell id="task" value="&lt;b&gt;Tarea Fargate (aglacita-tf-qa-api)&lt;/b&gt;&lt;br&gt;• 0,25 vCPU / 512 MB · X86_64 · awsvpc&lt;br&gt;• Contenedor api :8082 (Spring Boot, perfil qa)&lt;br&gt;• IP pública (no hay NAT)&lt;br&gt;• Sin health check de contenedor (la imagen no trae curl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#ED7100;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="cluster"><mxGeometry x="20" y="155" width="370" height="120" as="geometry"/></mxCell><mxCell id="sgapi" value="&lt;b&gt;SG api-sg&lt;/b&gt;&lt;br&gt;Entrada: solo vpclink-sg en TCP 8082&lt;br&gt;Salida: 0.0.0.0/0 (ECR, SSM, APIs externas, BD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EB;strokeColor=#DD344C;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="cluster"><mxGeometry x="20" y="290" width="370" height="105" as="geometry"/></mxCell><mxCell id="ecr" value="&lt;b&gt;ECR aglacita-tf-qa-api&lt;/b&gt;&lt;br&gt;• Etiquetas INMUTABLES&lt;br&gt;• Escaneo al subir&lt;br&gt;• Conserva las últimas 10 imágenes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#ED7100;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="30" y="615" width="230" height="110" as="geometry"/></mxCell><mxCell id="ssm" value="&lt;b&gt;SSM Parameter Store /aglacita-tf/qa/*&lt;/b&gt;&lt;br&gt;• 12 SecureString (value_wo, valor real cargado por script)&lt;br&gt;• 2 String: HOST_CORS, SPRING_PROFILES_ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE6F2;strokeColor=#E7157B;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="280" y="615" width="270" height="110" as="geometry"/></mxCell><mxCell id="iam" value="&lt;b&gt;IAM aglacita-tf-qa-api-execution&lt;/b&gt;&lt;br&gt;• Política administrada de ejecución de ECS&lt;br&gt;• Lectura solo de /aglacita-tf/qa/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8EB;strokeColor=#DD344C;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="570" y="615" width="230" height="110" as="geometry"/></mxCell><mxCell id="cwecs" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;/ecs/aglacita-tf-qa-api&lt;br&gt;retención 14 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE6F2;strokeColor=#E7157B;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="reg"><mxGeometry x="820" y="615" width="190" height="110" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Base de datos PostgreSQL&lt;/b&gt;&lt;br&gt;Fuera de Terraform&lt;br&gt;DB_URL / usuario / clave en SSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1570" y="270" width="210" height="85" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;APIs externas&lt;/b&gt;&lt;br&gt;DeepSeek · OpenAI · WhatsApp&lt;br&gt;HTTPS saliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1570" y="390" width="210" height="85" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="/* (OAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3F8624;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cf" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="VPC_LINK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigw" target="vpclink"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="TCP 8082" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vpclink" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="consulta SRV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="vpclink" target="cmap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="registra IP:8082" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="svc" target="cmap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="access logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="apigw" target="apilog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="pull imagen :etiqueta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ecr" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="secrets al arrancar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ssm" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="rol de ejecución" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DD344C;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="iam" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="logs awslogs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="task" target="cwecs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="task" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="task" target="ext"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ci-cd-y-secretos" name="CI-CD y secretos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gh" value="&lt;b&gt;GitHub · Ange1GL/bookingai_app (rama main)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2F6FDE;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="960" height="600" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Desarrollador&lt;/b&gt;&lt;br&gt;git push a main&lt;br&gt;o workflow_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="gh"><mxGeometry x="20" y="260" width="150" height="70" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Repositorio&lt;/b&gt;&lt;br&gt;backend/** · frontend/**&lt;br&gt;.aws/task-definition-backend.json&lt;br&gt;.github/workflows/*.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FF;strokeColor=#2F6FDE;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="gh"><mxGeometry x="200" y="250" width="230" height="90" as="geometry"/></mxCell><mxCell id="wfb" value="&lt;b&gt;Workflow backend.yaml&lt;/b&gt;&lt;br&gt;1. build + push de la imagen (tag = 7 primeros del commit)&lt;br&gt;2. renderiza la task definition con la imagen nueva&lt;br&gt;3. despliega en ECS y espera estabilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FF;strokeColor=#2F6FDE;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="gh"><mxGeometry x="480" y="90" width="260" height="125" as="geometry"/></mxCell><mxCell id="json" value="&lt;b&gt;.aws/task-definition-backend.json&lt;/b&gt;&lt;br&gt;Espejo de ecs.tf (14 secretos, sin health check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FF;strokeColor=#2F6FDE;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="gh"><mxGeometry x="480" y="20" width="260" height="60" as="geometry"/></mxCell><mxCell id="wff" value="&lt;b&gt;Workflow frontend.yaml&lt;/b&gt;&lt;br&gt;1. npm ci + build de producción&lt;br&gt;2. s3 sync (assets con hash) + index.html&lt;br&gt;3. invalidación de CloudFront (/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0FF;strokeColor=#2F6FDE;strokeWidth=2;fon